{
	"name": "activeyear",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler pages dev .svelte-kit/cloudflare --port $(node scripts/ports.ts)",
		"ports": "node scripts/ports.ts --urls",
		"prepare": "svelte-kit sync || echo '' && simple-git-hooks",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"test:run": "vitest run",
		"test:e2e": "playwright test",
		"test:all": "vitest run && playwright test",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"scan": "sh scripts/require-tools.sh gitleaks trivy && gitleaks git --no-banner --redact --log-opts=HEAD && trivy fs --scanners vuln --severity HIGH,CRITICAL --ignore-unfixed --exit-code 1 --skip-version-check --quiet .",
		"scan:staged": "sh scripts/require-tools.sh gitleaks && gitleaks git --staged --no-banner --redact",
		"knip": "knip",
		"og-image": "node scripts/og-image.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.6",
		"@types/papaparse": "^5.5.2",
		"@types/pngjs": "^6.0.5",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"knip": "^6.45.1",
		"lint-staged": "^17.6.0",
		"pixelmatch": "^8.0.0",
		"pngjs": "^7.0.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"simple-git-hooks": "^2.14.0",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"wrangler": "^4.156.0"
	},
	"dependencies": {
		"@fontsource/archivo": "^5.3.0",
		"@fontsource/big-shoulders-display": "^5.3.0",
		"@fontsource/geist-mono": "^5.3.0",
		"@fontsource/outfit": "^5.3.0",
		"@fontsource/press-start-2p": "^5.3.0",
		"@fontsource/vt323": "^5.3.0",
		"@sveltejs/kit": "^3.1.1",
		"@types/canvas-confetti": "^1.9.0",
		"canvas-confetti": "^1.9.4",
		"modern-screenshot": "^4.7.0",
		"papaparse": "^5.7.0",
		"phosphor-svelte": "^3.1.1",
		"svelte": "^5.57.3"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm exec lint-staged && pnpm scan:staged",
		"pre-push": "pnpm check && pnpm test:run && pnpm scan && pnpm knip"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"prettier --write",
			"eslint"
		],
		"*.{css,html,json,md,yaml,yml}": "prettier --write"
	}
}
